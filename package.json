{
  "name": "gbp-performance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Google Business Profile のパフォーマンスデータを定期取得してDBに保存するバッチ用スクリプト群",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "oauth:bootstrap": "tsx scripts/oauth-bootstrap.ts",
    "fetch:one-day": "tsx scripts/fetch-one-day.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^16.4.5",
    "prisma": "^7.8.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
