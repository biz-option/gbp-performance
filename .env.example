# このファイルはプレースホルダのみを含みます。実際の値は絶対にコミットしないでください。
# 実際の値は .env にコピーして記入します(.env は .gitignore 済み)。

# Cloud SQL (MySQL) への接続文字列
DATABASE_URL="mysql://user:password@localhost:3306/gbp_performance"

# GCP Console で発行した OAuth クライアント (デスクトップアプリ種別)
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/oauth2callback"
