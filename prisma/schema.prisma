// このファイルは docs/schema.sql と手動で同期します。
// `prisma migrate` は一切使用しません(DBへのDDL適用は docs/schema.sql を手動実行することで行います)。
// スキーマを変更する場合は、まず docs/schema.sql を更新し、その内容をこのファイルに反映してください。
// `npx prisma generate` は DB 接続なしで型/Client を生成するだけなので、変更後の整合性確認に使えます。
//
// 注意: 以下の @relation 定義は Prisma Client の型付きクエリ(include等)のために存在するだけで、
// DB に外部キー制約(FK)を作るものではありません(migrate/db push を実行しないため実DBには反映されません)。
// docs/schema.sql も意図的にFK制約なしで管理しています。

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 以降、接続文字列は datasource block の url ではなく、
// PrismaClient に渡す Driver Adapter(src/db/prismaClient.ts)側で指定する。
datasource db {
  provider = "mysql"
}

// 代理店(エージェンシー)。全てのビジネス(location)はいずれかの代理店に紐づく。
model Agency {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)
  // この日付以前の daily_metrics は確定済みとみなせる、代理店単位のウォーターマーク。
  // ある日付の取得結果に1件でも value <> 0 があれば fetchedDate - 1日 まで前進させる
  // (詳細は docs/schema.sql の同カラムのコメント参照)。
  confirmedThroughDate DateTime? @db.Date
  createdAt            DateTime  @default(now()) @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @db.DateTime(3)

  locations Location[]

  @@map("agencies")
}

// Google Business Profile 上の1ビジネス(店舗)拠点。
model Location {
  id               Int      @id @default(autoincrement())
  agencyId         Int
  googleLocationId String   @db.VarChar(255)
  name             String   @db.VarChar(255)
  createdAt        DateTime @default(now()) @db.DateTime(3)
  updatedAt        DateTime @updatedAt @db.DateTime(3)

  agency       Agency        @relation(fields: [agencyId], references: [id])
  dailyMetrics DailyMetric[]

  @@unique([agencyId, googleLocationId], name: "locations_agencyId_googleLocationId_key")
  @@map("locations")
}

// GBP Performance API から取得した日次メトリクスの実測値。
enum MetricType {
  BUSINESS_IMPRESSIONS_DESKTOP_MAPS
  BUSINESS_IMPRESSIONS_DESKTOP_SEARCH
  BUSINESS_IMPRESSIONS_MOBILE_MAPS
  BUSINESS_IMPRESSIONS_MOBILE_SEARCH
  CALL_CLICKS
  BUSINESS_BOOKINGS
  BUSINESS_DIRECTION_REQUESTS
  WEBSITE_CLICKS
}

model DailyMetric {
  id         BigInt     @id @default(autoincrement())
  locationId Int
  metricDate DateTime   @db.Date
  metricType MetricType
  value      Int
  createdAt  DateTime   @default(now()) @db.DateTime(3)
  updatedAt  DateTime   @updatedAt @db.DateTime(3)

  location Location @relation(fields: [locationId], references: [id])

  @@unique([locationId, metricDate, metricType], name: "daily_metrics_locationId_metricDate_metricType_key")
  @@index([metricDate], name: "daily_metrics_metricDate_idx")
  @@map("daily_metrics")
}

// Google OAuth のリフレッシュトークン等の認証情報。
// 実際の値は Claude が扱わない(手動での oauth:bootstrap 実行 → 手動INSERTを想定)。
model GoogleOauthCredential {
  id           Int       @id @default(autoincrement())
  accountLabel String    @unique @db.VarChar(255)
  refreshToken String    @db.Text
  scope        String    @db.VarChar(255)
  expiresAt    DateTime? @db.DateTime(3)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)

  @@map("google_oauth_credentials")
}
